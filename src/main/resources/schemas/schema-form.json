{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "condition": {
            "title": "Condition",
            "description": "EL expression evaluated on each record. The header is added only when it is true. Leave empty to always add it.",
            "type": "string",
            "x-schema-form": { "expression-language": true }
        },
        "headerName": {
            "title": "Header name",
            "type": "string"
        },
        "headerValue": {
            "title": "Header value",
            "type": "string"
        }
    },
    "required": ["headerName", "headerValue"]
}
